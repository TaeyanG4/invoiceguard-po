{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invoiceguard:extraction:1.0",
  "title": "InvoiceGuard raw extraction (not normalized)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_type": {
      "enum": [
        "invoice",
        "receipt",
        "unknown"
      ]
    },
    "invoice_number_raw": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "currency_raw": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "subtotal_raw": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "tax_raw": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "discount_raw": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "total_raw": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_index"
        ],
        "properties": {
          "row_index": {
            "type": "integer",
            "minimum": 1
          },
          "sku_raw": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "description_raw": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "quantity_raw": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "unit_raw": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "unit_price_raw": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "line_total_raw": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      }
    }
  }
}
