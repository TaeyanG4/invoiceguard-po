{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invoiceguard:public-extraction:1.0",
  "title": "Canonical public numeric extraction, NOT raw transcription",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "public-1.0"
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_index",
          "description",
          "quantity",
          "unit_price",
          "amount"
        ],
        "properties": {
          "row_index": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "quantity": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
            "maxLength": 80
          },
          "unit_price": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
            "maxLength": 80
          },
          "amount": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
            "maxLength": 80
          }
        }
      }
    }
  }
}
